{
  "name": "lancebuddy-upi-api",
  "version": "1.0.0",
  "private": true,
  "description": "UPI QR payment gateway API for LanceBuddy - Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "db:local": "wrangler d1 execute lancebuddy-payments --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute lancebuddy-payments --remote --file=./schema.sql",
    "tail": "wrangler tail",
    "setup": "node setup.js",
    "check": "node validate.js"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
